# Mercado Livre OAuth App – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ── Mercado Livre OAuth credentials ──────────────────────────────────────────
# Obtain these from https://developers.mercadolivre.com.br/

# Your application's Client ID (App ID).
MELI_CLIENT_ID=YOUR_CLIENT_ID_HERE

# Your application's Client Secret.
MELI_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# The redirect URI registered in your Mercado Livre app settings.
# Must match exactly what you registered on the developer portal.
# Example: http://localhost:3000/auth/callback
MELI_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Server ────────────────────────────────────────────────────────────────────
# Port on which the Express server will listen.
PORT=3000
